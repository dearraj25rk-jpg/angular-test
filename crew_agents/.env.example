# Angular Migration Crew Environment Variables

# OpenAI API Key (required for CrewAI agents)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom model settings
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.1

# Optional: Project settings
DEFAULT_PROJECT_PATH=.
DEFAULT_TARGET_VERSION=20.3.0

# Optional: Migration settings
SKIP_FAILING_TESTS=false
ENABLE_VERBOSE_LOGGING=true

# Optional: MCP settings
ANGULAR_CLI_TIMEOUT=600
NPM_INSTALL_TIMEOUT=600